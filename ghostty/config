# Ghostty config. Symlinked to ~/.config/ghostty/config by home-manager, so
# edits here apply live (reload with cmd+shift+, in Ghostty).
# Reference: https://ghostty.org/docs/config/reference
# Validate:  ghostty +validate-config

font-family = "PragmataPro Mono"
font-size = 14

theme = "GitHub Dark Dimmed"
# theme = "Material Darker"

background-opacity = 0.7
background-blur = 15
background-blur = macos-glass-regular

window-inherit-working-directory = false

# BEGIN CORGI GHOSTTY INTEGRATION
# Applies throughout Ghostty. Reload with Cmd+Shift+comma.
keybind = cmd+t=text:\x01c
keybind = cmd+w=text:\x01\x1b[120;2u
keybind = cmd+shift+t=text:\x01u
keybind = ctrl+tab=text:\x01n
keybind = ctrl+shift+tab=text:\x01p
keybind = cmd+1=text:\x011
keybind = cmd+2=text:\x012
keybind = cmd+3=text:\x013
keybind = cmd+4=text:\x014
keybind = cmd+5=text:\x015
keybind = cmd+6=text:\x016
keybind = cmd+7=text:\x017
keybind = cmd+8=text:\x018
keybind = cmd+9=text:\x019
keybind = cmd+digit_1=text:\x011
keybind = cmd+digit_2=text:\x012
keybind = cmd+digit_3=text:\x013
keybind = cmd+digit_4=text:\x014
keybind = cmd+digit_5=text:\x015
keybind = cmd+digit_6=text:\x016
keybind = cmd+digit_7=text:\x017
keybind = cmd+digit_8=text:\x018
keybind = cmd+digit_9=text:\x019
# END CORGI GHOSTTY INTEGRATION
